# ==========================================
# PragatiParikshan Frontend Environment Variables
# ==========================================

# Set this to your deployed backend API URL on Railway / Render / Koyeb:
# Example: https://pragatiparikshan-backend.up.railway.app/api/v1
# Defaults to http://127.0.0.1:8000/api/v1 for local development if not provided.
NEXT_PUBLIC_API_URL=https://your-backend-url.up.railway.app/api/v1
