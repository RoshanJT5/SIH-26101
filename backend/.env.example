# ==============================================================================
# PragatiParikshan — Backend Environment Configuration Example
# Smart India Hackathon 2026 (Problem Statement: SIH26101)
# ==============================================================================

# Application Environment: 'development' | 'staging' | 'production'
ENVIRONMENT=development

# Database Connection URL
# For Local SQLite:
DATABASE_URL=sqlite:///./sql_app.db
# For Production PostgreSQL (Render / Railway / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/pragatiparikshan_db

# Security & Session
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production

# Allowed CORS Origins (Comma-separated or wildcard in dev)
# Local development:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Production example:
# ALLOWED_ORIGINS=https://pragatiparikshan.gov.in,https://pragatiparikshan.vercel.app

# Demo Administrator Seeding & Access
# Set to 'true' for local prototype/demo environments
# Set to 'false' for strict production deployments
ENABLE_DEMO_ADMIN=true

# AI & LLM Inference (Groq Cloud API)
# Get key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# RAG & Semantic Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MAX_UPLOAD_SIZE_MB=25
